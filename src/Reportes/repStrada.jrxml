	<queryString language="SQL">
		<![CDATA[SELECT
     ventas.`idventa` AS ventas_idventa,
     ventas.`idcliente` AS ventas_idcliente,
     ventas.`idempleado` AS ventas_idempleado,
     ventas.`idvehiculo` AS ventas_idvehiculo,
     ventas.`fecha` AS ventas_fecha,
     ventas.`precioventa` AS ventas_precioventa,
     ventas.`descuentoventa` AS ventas_descuentoventa,
     ventas.`isv` AS ventas_isv,
     ventas.`totalventa` AS ventas_totalventa,
     ventas.`idestadoventa` AS ventas_idestadoventa
FROM
     `ventas` ventas]]>
	</queryString>
