	<queryString language="SQL">
		<![CDATA[SELECT
     vista_alquiler.`idalquiler` AS vista_alquiler_idalquiler,
     vista_alquiler.`cliente` AS vista_alquiler_cliente,
     vista_alquiler.`empleado` AS vista_alquiler_empleado,
     vista_alquiler.`vehiculo` AS vista_alquiler_vehiculo,
     vista_alquiler.`fechainicio` AS vista_alquiler_fechainicio,
     vista_alquiler.`totaldias` AS vista_alquiler_totaldias,
     vista_alquiler.`preciopordia` AS vista_alquiler_preciopordia,
     vista_alquiler.`subtotal` AS vista_alquiler_subtotal,
     vista_alquiler.`garantia` AS vista_alquiler_garantia,
     vista_alquiler.`isv` AS vista_alquiler_isv,
     vista_alquiler.`descuentoalquiler` AS vista_alquiler_descuentoalquiler,
     vista_alquiler.`totalpagar` AS vista_alquiler_totalpagar,
     vista_alquiler.`kilometrajeinicial` AS vista_alquiler_kilometrajeinicial,
     vista_alquiler.`estado` AS vista_alquiler_estado
FROM
     `vista_alquiler` vista_alquiler]]>
	</queryString>
