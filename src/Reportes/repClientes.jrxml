     vista_cliente.`correo` AS vista_cliente_correo,
     vista_cliente.`direccion` AS vista_cliente_direccion,
     vista_cliente.`telefono` AS vista_cliente_telefono,
     vista_cliente.`segmentacion` AS vista_cliente_segmentacion
FROM
     `vista_cliente` vista_cliente]]>
