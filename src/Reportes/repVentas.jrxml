	<queryString language="SQL">
		<![CDATA[SELECT
     vista_ventas.`idventa` AS vista_ventas_idventa,
     vista_ventas.`cliente` AS vista_ventas_cliente,
     vista_ventas.`empleado` AS vista_ventas_empleado,
     vista_ventas.`vehiculo` AS vista_ventas_vehiculo,
     vista_ventas.`fecha` AS vista_ventas_fecha,
     vista_ventas.`precioventa` AS vista_ventas_precioventa,
     vista_ventas.`descuentoventa` AS vista_ventas_descuentoventa,
     vista_ventas.`isv` AS vista_ventas_isv,
     vista_ventas.`totalventa` AS vista_ventas_totalventa,
     vista_ventas.`descripcion` AS vista_ventas_descripcion
FROM
     `vista_ventas` vista_ventas]]>
	</queryString>
