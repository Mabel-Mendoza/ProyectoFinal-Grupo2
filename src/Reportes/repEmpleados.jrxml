	<queryString language="SQL">
		<![CDATA[SELECT
     vista_empleados_detalle.`idempleado` AS vista_empleados_detalle_idempleado,
     vista_empleados_detalle.`nombreempleado` AS vista_empleados_detalle_nombreempleado,
