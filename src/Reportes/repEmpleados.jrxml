     vista_empleados_detalle.`sexo` AS vista_empleados_detalle_sexo,
     vista_empleados_detalle.`correo` AS vista_empleados_detalle_correo,
     vista_empleados_detalle.`direccion` AS vista_empleados_detalle_direccion,
     vista_empleados_detalle.`telefono` AS vista_empleados_detalle_telefono,
     vista_empleados_detalle.`puesto` AS vista_empleados_detalle_puesto,
     vista_empleados_detalle.`jornada` AS vista_empleados_detalle_jornada,
     vista_empleados_detalle.`estado` AS vista_empleados_detalle_estado
FROM
     `vista_empleados_detalle` vista_empleados_detalle]]>
